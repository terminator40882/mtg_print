# Kopieren nach .env und anpassen:  cp .env.example .env

# IP-Adresse des Canon PIXMA G650 im Heimnetz (am besten im Router fest vergeben)
PRINTER_IP=192.168.178.50

# Optional: vollständige IPP-URI statt IP (überschreibt PRINTER_IP)
# PRINTER_URI=ipp://192.168.178.50:631/ipp/print

# Port der Web-Oberfläche auf dem Host
APP_PORT=8080

# Papiertyp: "auto" wählt automatisch Glossy II bzw. das passende Glossy-Fotopapier,
# das der Drucker per IPP meldet. Alternativ exakten Wert setzen, z.B. PhotographicGlossy
PRINT_MEDIA_TYPE=auto

# Druckqualität: high | normal | draft
PRINT_QUALITY=high

# Papierzufuhr: auto (Druckerstandard) oder z.B. Rear / Main
PRINT_INPUT_SLOT=auto

# CUPS-Protokoll: info (Standard) oder debug für die Fehlersuche
CUPS_LOG_LEVEL=info

# Name der CUPS-Queue im Container
PRINTER_QUEUE=Canon_G650

TZ=Europe/Berlin
